{
  "name": "pencil-faces",
  "version": "0.1.0",
  "description": "Pencil-drawn passport-photo portraits as SVG strings, generated from a seed or a config.",
  "keywords": [
    "svg",
    "avatar",
    "avatar-generator",
    "face",
    "portrait",
    "pencil",
    "sketch",
    "procedural",
    "seed",
    "deterministic"
  ],
  "license": "MIT",
  "author": "Marian Becher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarianBecher/pencil-faces.git"
  },
  "homepage": "https://github.com/MarianBecher/pencil-faces#readme",
  "bugs": {
    "url": "https://github.com/MarianBecher/pencil-faces/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "vite demo",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
